# Copy to psp.env and edit (same directory as startup-psp.sh).
# Loaded automatically if present. Overrides script defaults below.
#
# PSP_XMS=512m
# PSP_XMX=4g
# PSP_TOMCAT_PORT=8080
# PSP_AWT_HEADLESS=false
# PSP_JAVA_OPTS_EXTRA=-XX:+HeapDumpOnOutOfMemoryError
#
# Or set the full string (skips all of the above):
# JAVA_OPTS=-Xms512m -Xmx4g -Djava.awt.headless=false -Dtomcat.port=8080
